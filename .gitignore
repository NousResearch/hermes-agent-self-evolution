__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
.env

# Generated eval datasets (local, not shared)
datasets/**/*.jsonl
datasets/**/*.json
!datasets/.gitkeep

# Evolution snapshots
snapshots/
*.pkl

# Run artifacts. Every phase writes output/<phase>/<timestamp>/, so without this
# a contributor's own runs pile up in git status and eventually get committed by
# an `add -A`. A worked example lives in docs/example-run/ instead.
output/

# IDE
.idea/
.vscode/
*.swp
*.swo
