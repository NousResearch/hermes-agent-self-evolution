{
  "phase": "3",
  "mode": "phase3-execution-seed-draft",
  "status": "drafted_not_executed",
  "execution_seed": "seeds/phase3_system_prompt_evolution_execution_seed_draft.yaml",
  "source_design_plan": "reports/phase3_system_prompt_evolution_plan.json",
  "source_design_seed": "seeds/phase3_system_prompt_evolution_seed.yaml",
  "phase2e_closeout_dependency": "reports/phase2e_human_review_checkpoint.json",
  "source_authorization": "rec action GO",
  "goal": "Draft the future Phase 3 system prompt evolution execution contract without running GEPA/DSPy or applying prompt/source changes.",
  "execution_started": false,
  "run_gepa_now": false,
  "run_dspy_now": false,
  "mutate_active_system_prompt_now": false,
  "active_system_prompt_apply_approved": false,
  "apply_ready": false,
  "requires_human_approval_before_execution": true,
  "requires_human_approval_before_apply": true,
  "future_execution_scope": {
    "mode": "candidate_only_system_prompt_evolution",
    "output_root": "output/phase3-system-prompt/<run-id>/",
    "baseline_prompt_artifact": "output/phase3-system-prompt/<run-id>/baseline_system_prompt.json",
    "candidate_prompt_artifact": "output/phase3-system-prompt/<run-id>/candidate_system_prompt.json",
    "report_artifact": "output/phase3-system-prompt/<run-id>/candidate_only_report.json",
    "allowed_result": "candidate report and review packet only; no active prompt/source apply"
  },
  "benchmark_gate": {
    "status": "required_not_run",
    "required_before_execution": true,
    "blocking_for_execution": true,
    "source_decision": "reports/phase2e_benchmark_gate_decision.json",
    "deferred_benchmarks": [
      "TBLite",
      "YC-Bench"
    ],
    "required_before": [
      "phase3_execution",
      "system_prompt_evolution_acceptance",
      "active_system_prompt_apply",
      "default_gate_promotion"
    ],
    "command_policy": "Templates plus verified read-only dry-run fixture adapters; real benchmark results remain required before any Phase 3 execution.",
    "command_templates": [
      {
        "name": "TBLite",
        "status": "dry_run_adapter_contract_verified",
        "must_pass_before": "phase3_execution",
        "module": "evolution.benchmarks.run_tblite",
        "command": "python -m evolution.benchmarks.run_tblite --baseline-prompt output/phase3-system-prompt/<run-id>/baseline_system_prompt.json --candidate-prompt output/phase3-system-prompt/<run-id>/candidate_system_prompt.json --fixtures-jsonl datasets/golden/benchmarks/phase3-system-prompt/tblite_cases.jsonl --output-json output/phase3-system-prompt/<run-id>/benchmarks/tblite.json --dry-run",
        "output_json": "output/phase3-system-prompt/<run-id>/benchmarks/tblite.json",
        "pass_condition": "no_regression_against_baseline"
      },
      {
        "name": "YC-Bench",
        "status": "dry_run_adapter_contract_verified",
        "must_pass_before": "phase3_execution",
        "module": "evolution.benchmarks.run_yc_bench",
        "command": "python -m evolution.benchmarks.run_yc_bench --baseline-prompt output/phase3-system-prompt/<run-id>/baseline_system_prompt.json --candidate-prompt output/phase3-system-prompt/<run-id>/candidate_system_prompt.json --fixtures-jsonl datasets/golden/benchmarks/phase3-system-prompt/yc_bench_fast_test.jsonl --preset fast_test --output-json output/phase3-system-prompt/<run-id>/benchmarks/yc_bench.json --dry-run",
        "output_json": "output/phase3-system-prompt/<run-id>/benchmarks/yc_bench.json",
        "pass_condition": "coherence_score_holds_or_improves"
      }
    ],
    "adapter_contract": {
      "status": "dry_run_fixture_contract_verified",
      "read_only": true,
      "dry_run_required": true,
      "external_calls_allowed": false,
      "active_prompt_or_source_apply_allowed": false,
      "verified_by": "tests/tools/test_phase3_benchmark_adapters.py",
      "output_json_constraints": {
        "allowed_root": "output/phase3-system-prompt/",
        "suffix": ".json",
        "path_traversal": "resolved_path_must_remain_under_allowed_root"
      },
      "external_call_guard": {
        "strategy": "pytest monkeypatch blocks socket, urllib.request.urlopen, subprocess.run/Popen, and os.system during in-process adapter main calls",
        "verified_by": "tests/tools/test_phase3_benchmark_adapters.py"
      },
      "output_schema_required_fields": [
        "benchmark",
        "adapter_version",
        "mode",
        "dry_run",
        "candidate_only",
        "read_only",
        "external_calls_performed",
        "apply_ready",
        "pass_condition",
        "passed",
        "failed_checks",
        "prompt_artifacts",
        "fixture_cases",
        "metrics",
        "cases",
        "artifacts",
        "write_targets",
        "output_constraints"
      ],
      "adapters": [
        {
          "name": "TBLite",
          "module": "evolution.benchmarks.run_tblite",
          "pass_condition": "no_regression_against_baseline",
          "fixture_baseline_prompt": "datasets/golden/benchmarks/phase3-system-prompt/baseline_system_prompt.json",
          "fixture_candidate_prompt": "datasets/golden/benchmarks/phase3-system-prompt/candidate_system_prompt.json",
          "fixtures_jsonl": "datasets/golden/benchmarks/phase3-system-prompt/tblite_cases.jsonl",
          "fixture_output_json": "output/phase3-system-prompt/dry-run/benchmarks/tblite.json",
          "fixture_command": "python -m evolution.benchmarks.run_tblite --baseline-prompt datasets/golden/benchmarks/phase3-system-prompt/baseline_system_prompt.json --candidate-prompt datasets/golden/benchmarks/phase3-system-prompt/candidate_system_prompt.json --fixtures-jsonl datasets/golden/benchmarks/phase3-system-prompt/tblite_cases.jsonl --output-json output/phase3-system-prompt/dry-run/benchmarks/tblite.json --dry-run"
        },
        {
          "name": "YC-Bench",
          "module": "evolution.benchmarks.run_yc_bench",
          "preset": "fast_test",
          "pass_condition": "coherence_score_holds_or_improves",
          "fixture_baseline_prompt": "datasets/golden/benchmarks/phase3-system-prompt/baseline_system_prompt.json",
          "fixture_candidate_prompt": "datasets/golden/benchmarks/phase3-system-prompt/candidate_system_prompt.json",
          "fixtures_jsonl": "datasets/golden/benchmarks/phase3-system-prompt/yc_bench_fast_test.jsonl",
          "fixture_output_json": "output/phase3-system-prompt/dry-run/benchmarks/yc_bench.json",
          "fixture_command": "python -m evolution.benchmarks.run_yc_bench --baseline-prompt datasets/golden/benchmarks/phase3-system-prompt/baseline_system_prompt.json --candidate-prompt datasets/golden/benchmarks/phase3-system-prompt/candidate_system_prompt.json --fixtures-jsonl datasets/golden/benchmarks/phase3-system-prompt/yc_bench_fast_test.jsonl --preset fast_test --output-json output/phase3-system-prompt/dry-run/benchmarks/yc_bench.json --dry-run"
        }
      ]
    }
  },
  "rollback_boundary": {
    "checkpoint_required_before_candidate_generation": true,
    "baseline_prompt_snapshot_required": true,
    "baseline_prompt_checksum_required": true,
    "candidate_output_dir": "output/phase3-system-prompt/<run-id>/",
    "rollback_handle_required_before_apply": true,
    "active_runtime_rollback_required_before_apply": true,
    "allowed_write_roots_before_approval": [
      "output/phase3-system-prompt/<run-id>/",
