    "blocking_for_execution": true,
    "source_decision": "reports/phase2e_benchmark_gate_decision.json",
    "deferred_benchmarks": [
      "TBLite",
      "YC-Bench"
    ],
    "required_before": [
      "phase3_execution",
      "system_prompt_evolution_acceptance",
      "active_system_prompt_apply",
      "default_gate_promotion"
    ],
    "command_policy": "Templates only; benchmark adapters/results must be verified before any Phase 3 execution.",
    "command_templates": [
      {
        "name": "TBLite",
        "status": "draft_not_executed",
        "must_pass_before": "phase3_execution",
        "command": "python -m evolution.benchmarks.run_tblite --baseline-prompt output/phase3-system-prompt/<run-id>/baseline_system_prompt.json --candidate-prompt output/phase3-system-prompt/<run-id>/candidate_system_prompt.json --output-json output/phase3-system-prompt/<run-id>/benchmarks/tblite.json",
        "output_json": "output/phase3-system-prompt/<run-id>/benchmarks/tblite.json",
        "pass_condition": "no_regression_against_baseline"
      },
      {
        "name": "YC-Bench",
        "status": "draft_not_executed",
        "must_pass_before": "phase3_execution",
        "command": "python -m evolution.benchmarks.run_yc_bench --baseline-prompt output/phase3-system-prompt/<run-id>/baseline_system_prompt.json --candidate-prompt output/phase3-system-prompt/<run-id>/candidate_system_prompt.json --preset fast_test --output-json output/phase3-system-prompt/<run-id>/benchmarks/yc_bench.json",
        "output_json": "output/phase3-system-prompt/<run-id>/benchmarks/yc_bench.json",
        "pass_condition": "coherence_score_holds_or_improves"
      }
    ]
  },
  "rollback_boundary": {
    "checkpoint_required_before_candidate_generation": true,
    "baseline_prompt_snapshot_required": true,
    "baseline_prompt_checksum_required": true,
    "candidate_output_dir": "output/phase3-system-prompt/<run-id>/",
