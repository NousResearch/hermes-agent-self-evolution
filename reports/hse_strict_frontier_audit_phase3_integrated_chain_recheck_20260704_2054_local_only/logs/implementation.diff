+        and noop_apply_closure.get("closure_reconciliation", {}).get("apply_lane_status") == "NO_ACTIVE_WRITE_REQUIRED"
+        and noop_apply_closure.get("closure_reconciliation", {}).get("semantic_noop_confirmed") is True
