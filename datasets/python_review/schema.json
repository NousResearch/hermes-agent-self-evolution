{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kafo:benchmark:python-review:case:v1",
  "title": "Python review benchmark case",
  "description": "One labelled Python code-review case, stored as one JSON object per JSONL line. Line numbers are 1-based and inclusive, counted on newline characters in code. Cross-field rules (line_end >= line_start, line_end within the snippet, defect_id unique) are enforced by evolution/adaptive/benchmark.py.",
  "type": "object",
  "required": ["case_id", "split", "language", "code", "context", "defects"],
  "additionalProperties": false,
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "split": {"type": "string", "enum": ["train", "validation", "test"]},
    "language": {"type": "string", "const": "python"},
    "code": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "required": ["difficulty", "domain"],
      "additionalProperties": false,
      "properties": {
        "difficulty": {"type": "string", "enum": ["simple", "moderate", "complex"]},
        "domain": {"type": "string", "minLength": 1}
      }
    },
    "defects": {
      "type": "array",
      "description": "Ground-truth defects. Empty for clean control cases.",
      "items": {
        "type": "object",
        "required": ["defect_id", "category", "line_start", "line_end", "severity", "description"],
        "additionalProperties": false,
        "properties": {
          "defect_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
